# All optional. The demo runs fully without any of these.

# If set, live Gemini is used for OCR / strip scan / explanations / drug info.
# If unset, the app serves pre-baked fixture responses (recommended for demos).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional text-only fallback provider.
GROQ_API_KEY=

# Forces the cached/fixture AI path even when GEMINI_API_KEY is present.
DEMO_MODE=1

# Demo city bounding box (south,west,north,east) — Lucknow, India.
DEMO_CITY_BBOX=26.72,80.82,26.95,81.05
NEXT_PUBLIC_DEMO_CITY=Lucknow
